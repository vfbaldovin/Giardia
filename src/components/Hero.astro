---
import { Image } from 'astro:assets';
import cover from '../assets/vol1-cover.jpg';
import { site, links, releases } from '../data/site';

const album = releases.find((r) => r.type === 'album')!;
---

<section
  class="relative flex min-h-[100svh] flex-col justify-end overflow-hidden"
  aria-labelledby="titlu-principal"
>
  <!-- Fundal: coperta Vol. 1, estompata. eager + fetchpriority: e elementul
       LCP, deci nu are voie sa astepte. -->
  <div class="absolute inset-0 -z-10">
    <Image
      src={cover}
      alt=""
      widths={[640, 1024, 1600, 2048]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      class="h-full w-full scale-110 object-cover opacity-40 blur-[2px]"
      aria-hidden="true"
    />
    <!-- Vignette + tenta verde, ca textul sa aiba contrast garantat -->
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_35%,transparent_0%,rgba(7,8,10,0.75)_55%,var(--color-void)_100%)]"
    >
    </div>
    <div class="absolute inset-0 bg-bile/25 mix-blend-color"></div>
    <div class="scanlines absolute inset-0 opacity-30"></div>
  </div>

  <div class="mx-auto w-full max-w-[100rem] px-5 pb-16 pt-32 md:px-8 md:pb-20">
    <p class="label mb-6 flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="inline-block h-px w-10 bg-slime align-middle"></span>
      {site.genres.join(' / ')}
      <span class="text-slime">●</span>
      România
    </p>

    <!-- Wordmark. Doua copii colorate in spate dau aberatia cromatica,
         fara filtre scumpe si fara sa afecteze textul citit de screen reader. -->
    <h1 id="titlu-principal" class="relative select-none">
      <span class="sr-only">{site.name} — {site.tagline}</span>
      <span
        aria-hidden="true"
        class="font-display relative block text-[22vw] font-black uppercase leading-[0.75] tracking-[-0.03em] text-bone md:text-[19vw]"
      >
        <span
          class="absolute inset-0 translate-x-[0.35vw] text-viral opacity-70 mix-blend-screen"
          >{site.name}</span
        >
        <span
          class="absolute inset-0 -translate-x-[0.35vw] text-slime opacity-60 mix-blend-screen"
          >{site.name}</span
        >
        <span class="relative">{site.name}</span>
      </span>
    </h1>

    <div
      class="mt-10 flex flex-col gap-8 border-t border-moss/40 pt-8 md:flex-row md:items-end md:justify-between"
    >
      <p class="max-w-md text-lg leading-relaxed text-bone/80 md:text-xl">
        Riff-uri groase, tempo care te calcă și versuri în română care nu se iau
        în serios. Album de debut — <strong class="text-bone">{album.title}</strong>,
        {album.year} — afară acum.
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <a class="btn btn-solid" href="#muzica">
          Ascultă {album.title}
        </a>
        <a
          class="btn"
          href={links.spotify}
          target="_blank"
          rel="noopener noreferrer"
        >
          Spotify
        </a>
        <a class="btn" href="/joc">Joacă</a>
      </div>
    </div>
  </div>

  <!-- Indicator de scroll -->
  <div
    class="pointer-events-none absolute bottom-5 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 md:flex"
    aria-hidden="true"
  >
    <span class="label text-[0.6rem]">Scroll</span>
    <span class="block h-10 w-px animate-pulse bg-gradient-to-b from-slime to-transparent"
    ></span>
  </div>
</section>
