---
import SectionHead from './SectionHead.astro';
import { links } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

type Card = {
  key: 'instagram' | 'youtube' | 'spotify';
  title: string;
  body: string;
  href: string;
  handle: string;
  accent: string;
};

const cards: Card[] = [
  {
    key: 'instagram',
    title: t.follow.instagram,
    body: t.follow.instagramBody,
    href: links.instagram,
    handle: '@giardia.adevarat',
    accent: 'group-hover:text-viral',
  },
  {
    key: 'youtube',
    title: t.follow.youtube,
    body: t.follow.youtubeBody,
    href: links.youtube,
    handle: '@giardia-r1q',
    accent: 'group-hover:text-[#ff4444]',
  },
  {
    key: 'spotify',
    title: t.follow.spotify,
    body: t.follow.spotifyBody,
    href: links.spotify,
    handle: 'GIARDIA',
    accent: 'group-hover:text-slime',
  },
].filter((c) => Boolean(c.href)) as Card[];
---

<section id="follow" class="mx-auto max-w-[100rem] px-5 py-24 md:px-8 md:py-32">
  <SectionHead index="06" title={t.follow.title} note={t.follow.note} />

  <div class="grid gap-3 md:grid-cols-3">
    {
      cards.map((c) => (
        <a
          href={c.href}
          target="_blank"
          rel="noopener noreferrer"
          class="reveal group relative flex min-h-[19rem] flex-col justify-between overflow-hidden border border-moss/40 bg-void-2 p-7 transition-colors duration-500 hover:border-slime/60"
        >
          {/* Pata de lumina care creste la hover */}
          <span
            class="pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full bg-slime/10 blur-2xl transition-transform duration-700 group-hover:scale-150"
            aria-hidden="true"
          />

          <div class="relative flex items-start justify-between">
            <span class:list={['text-bone/70 transition-colors duration-500', c.accent]}>
              {c.key === 'instagram' && (
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect
                    x="2.5" y="2.5" width="19" height="19" rx="5.5"
                    stroke="currentColor" stroke-width="1.6"
                  />
                  <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6" />
                  <circle cx="17.4" cy="6.6" r="1.25" fill="currentColor" />
                </svg>
              )}
              {c.key === 'youtube' && (
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect
                    x="1.8" y="5" width="20.4" height="14" rx="4.4"
                    stroke="currentColor" stroke-width="1.6"
                  />
                  <path d="M10.2 9.3v5.4L15 12z" fill="currentColor" />
                </svg>
              )}
              {c.key === 'spotify' && (
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="9.4" stroke="currentColor" stroke-width="1.6" />
                  <path
                    d="M7.4 9.4c3-.85 6.2-.6 8.9.8M8 12.4c2.5-.7 5.1-.5 7.3.7M8.6 15.3c2-.55 4.1-.4 5.9.55"
                    stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                  />
                </svg>
              )}
            </span>
            <span class="label transition-colors duration-500 group-hover:text-slime">
              {c.handle}
            </span>
          </div>

          <div class="relative">
            <h3 class="font-display text-3xl font-bold uppercase leading-[0.9] text-bone md:text-4xl">
              {c.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-bone/65">{c.body}</p>
            <span class="label mt-6 flex items-center gap-2 text-slime">
              {t.follow.cta}
              <span
                class="transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </span>
          </div>
        </a>
      ))
    }
  </div>
</section>
