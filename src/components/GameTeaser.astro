---
import SectionHead from './SectionHead.astro';
---

<section class="mx-auto max-w-[100rem] px-5 py-24 md:px-8 md:py-32">
  <SectionHead index="05" title="Jocul" note="în browser · gratis" />

  <div
    class="reveal relative overflow-hidden border border-moss/40 bg-void-2 p-8 md:p-14"
  >
    <!-- Fundal: grila subtila, ca un ecran de arcade -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.06]"
      style="background-image:linear-gradient(var(--color-slime) 1px,transparent 1px),linear-gradient(90deg,var(--color-slime) 1px,transparent 1px);background-size:32px 32px"
      aria-hidden="true"
    >
    </div>

    <div class="relative grid items-center gap-10 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <h3 class="font-display text-5xl font-black uppercase leading-[0.85] text-bone md:text-7xl">
          Giardia<br />
          <span class="text-slime">The Game</span>
        </h3>
        <p class="mt-6 max-w-lg text-lg text-bone/80">
          Ești parazitul. Intestinul e terenul. Mănâncă tot ce prinzi, crește,
          și ferește-te de metronidazol — pastilele nu glumesc.
        </p>
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
          {
            ['Tastatură + swipe', 'Fără instalare', 'Scor salvat local'].map((f) => (
              <li class="label flex items-center gap-2">
                <span class="text-slime">▸</span>
                {f}
              </li>
            ))
          }
        </ul>
        <a class="btn btn-solid mt-9" href="/joc">Intră în intestin</a>
      </div>

      <!-- Mini-previzualizare statica: aceeasi grila ca in joc -->
      <div class="relative mx-auto w-full max-w-sm" aria-hidden="true">
        <div class="aspect-square border border-slime/40 bg-void p-3">
          <div class="grid h-full grid-cols-8 grid-rows-8 gap-1">
            {
              Array.from({ length: 64 }).map((_, i) => {
                const body = [27, 28, 29, 21, 13, 12].includes(i);
                const head = i === 27;
                const food = i === 42;
                return (
                  <div
                    class:list={[
                      'rounded-[2px]',
                      head
                        ? 'bg-slime'
                        : body
                          ? 'bg-moss'
                          : food
                            ? 'bg-viral'
                            : 'bg-bone/[0.03]',
                    ]}
                  />
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
