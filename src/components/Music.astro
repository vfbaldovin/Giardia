---
import { Image } from 'astro:assets';
import cover from '../assets/vol1-cover.jpg';
import SectionHead from './SectionHead.astro';
import { releases, links, spotify } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const album = releases.find((r) => r.type === 'album')!;
const single = releases.find((r) => r.type === 'single');
---

<section id="muzica" class="mx-auto max-w-[100rem] px-5 py-24 md:px-8 md:py-32">
  <SectionHead index="01" title={t.music.title} note={t.music.releases(releases.length)} />

  <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16">
    <div class="reveal">
      <div class="group relative overflow-hidden border border-moss/40">
        <Image
          src={cover}
          alt={t.music.coverAlt(album.title)}
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 45vw, 92vw"
          loading="lazy"
          class="aspect-square w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03]"
        />
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void via-transparent to-transparent opacity-70"
        >
        </div>
      </div>

      <div class="mt-6 flex items-baseline justify-between gap-4 border-b border-moss/40 pb-3">
        <h3 class="font-display text-4xl font-black uppercase text-bone md:text-5xl">
          {album.title}
        </h3>
        <span class="label shrink-0">{t.music.album} · {album.year}</span>
      </div>

      <ol class="mt-1">
        {
          album.tracks.map((track, i) => (
            <li class="flex items-center gap-4 border-b border-moss/15 py-3 text-bone/85 transition-colors hover:text-bone">
              <span class="label w-6 shrink-0 tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="font-sans text-base md:text-lg">{track}</span>
            </li>
          ))
        }
      </ol>

      {
        single && (
          <p class="label mt-5">
            {t.music.prevSingle} <span class="text-bone">{single.title}</span> ({single.year})
          </p>
        )
      }
    </div>

    <div class="reveal flex flex-col gap-6">
      <div class="border border-moss/40 bg-void-2 p-1">
        <iframe
          title={t.music.embedTitle}
          src={`https://open.spotify.com/embed/artist/${spotify.artistId}?utm_source=generator&theme=0`}
          width="100%"
          height="420"
          style="border:0"
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          allowfullscreen></iframe>
      </div>

      <div class="flex flex-wrap gap-3">
        <a class="btn" href={links.spotify} target="_blank" rel="noopener noreferrer">
          {t.music.openSpotify}
        </a>
        {
          links.youtube && (
            <a class="btn" href={links.youtube} target="_blank" rel="noopener noreferrer">
              YouTube
            </a>
          )
        }
        {
          links.bandcamp && (
            <a class="btn" href={links.bandcamp} target="_blank" rel="noopener noreferrer">
              Bandcamp
            </a>
          )
        }
      </div>

      <p class="max-w-prose text-bone/70">{t.music.note}</p>
    </div>
  </div>
</section>
