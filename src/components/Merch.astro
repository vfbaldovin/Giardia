---
import SectionHead from './SectionHead.astro';
import { merch, site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const hasPhotos = merch.some((m) => m.image);

/** Numele produselor vin din traduceri, nu din date — datele tin doar tipul. */
const nameFor = (i: number) => (i === 0 ? t.merch.items.shirt : t.merch.items.stickers);
---

<section id="merch" class="mx-auto max-w-[100rem] px-5 py-24 md:px-8 md:py-32">
  <SectionHead
    index="04"
    title={t.merch.title}
    note={hasPhotos ? t.merch.available : t.merch.inProduction}
  />

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      merch.map((item, i) => (
        <article class="reveal group relative flex aspect-[4/5] flex-col justify-between overflow-hidden border border-moss/40 bg-void-2 p-6">
          {item.image ? (
            <img
              src={item.image}
              alt={nameFor(i)}
              width="800"
              height="1000"
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover opacity-80 transition-transform duration-700 group-hover:scale-105"
            />
          ) : (
            /* Fara poza inca: un placeholder care arata intentionat, nu rupt */
            <div
              class="absolute inset-0 opacity-[0.07]"
              style="background-image:repeating-linear-gradient(45deg,var(--color-slime) 0 2px,transparent 2px 14px)"
              aria-hidden="true"
            />
          )}

          <div class="relative flex items-start justify-between gap-3">
            <span class="label">{t.merch.kinds[item.kind]}</span>
            {item.soldOut && <span class="label text-viral">{t.shows.soldOut}</span>}
          </div>

          <div class="relative">
            <h3 class="font-display text-3xl font-bold uppercase leading-none text-bone">
              {nameFor(i)}
            </h3>
            <p class="label mt-2">{item.price ?? t.merch.priceSoon}</p>
          </div>
        </article>
      ))
    }

    <article
      class="reveal flex aspect-[4/5] flex-col justify-center border border-dashed border-moss/50 p-6 text-center"
    >
      <p class="font-display text-3xl font-bold uppercase leading-none text-bone">
        {t.merch.soon}
      </p>
      <p class="mt-3 text-sm text-bone/70">{t.merch.soonBody}</p>
      <a class="btn mx-auto mt-6" href={`mailto:${site.email}?subject=Merch`}>
        {t.merch.notify}
      </a>
    </article>
  </div>
</section>
