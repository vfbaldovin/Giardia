---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { photoCredit } from '../data/site';

import bass from '../assets/photos/live-bass.jpg';
import guitar from '../assets/photos/live-guitar.jpg';
import drums from '../assets/photos/live-drums.jpg';
import portrait from '../assets/photos/live-portrait.jpg';
import solo from '../assets/photos/live-solo.jpg';

// span = cate coloane ocupa in grila de 6, ca sa iasa un mozaic asimetric.
const photos = [
  { src: guitar, alt: 'Chitaristul GIARDIA pe scenă, în timpul unui concert', span: 'md:col-span-3' },
  { src: drums, alt: 'Bateristul GIARDIA văzut de jos, în plin ritm', span: 'md:col-span-3' },
  { src: solo, alt: 'Chitarist GIARDIA în lumini violet, cu expunere lungă', span: 'md:col-span-2' },
  { src: bass, alt: 'Basistul GIARDIA aplecat peste instrument, pe scenă', span: 'md:col-span-2' },
  { src: portrait, alt: 'Portret alb-negru al unui membru GIARDIA în concert', span: 'md:col-span-2' },
];
---

<section id="galerie" class="mx-auto max-w-[100rem] px-5 py-24 md:px-8 md:py-32">
  <SectionHead index="02" title="Galerie" note={`Foto: ${photoCredit}`} />

  <div class="reveal grid grid-cols-1 gap-3 md:grid-cols-6">
    {
      photos.map((p, i) => (
        <figure class:list={['photo group relative overflow-hidden border border-moss/30', p.span]}>
          <Image
            src={p.src}
            alt={p.alt}
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 40vw, 92vw"
            loading={i < 2 ? 'eager' : 'lazy'}
            class="aspect-[4/5] w-full object-cover md:aspect-[3/4]"
          />
          <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 translate-y-2 bg-gradient-to-t from-void to-transparent p-4 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
            <span class="label text-bone/80">© {photoCredit}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <p class="label mt-6">
    Toate fotografiile © {photoCredit}. Reproducere doar cu acord.
  </p>
</section>
