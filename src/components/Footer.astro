---
import { site, links, photoCredit } from '../data/site';
import LangSwitch from './LangSwitch.astro';
import { useTranslations, anchor, pathFor, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  route: RouteKey;
}
const { lang, route } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const quick = [
  { label: t.nav.music, href: anchor('muzica', lang) },
  { label: t.nav.game, href: pathFor('game', lang) },
  { label: 'Instagram', href: links.instagram, ext: true },
  { label: 'YouTube', href: links.youtube, ext: true },
  { label: 'Spotify', href: links.spotify, ext: true },
  { label: t.footer.email, href: `mailto:${site.email}` },
];
---

<footer class="border-t border-moss/40">
  <div class="mx-auto max-w-[100rem] px-5 py-14 md:px-8">
    <!-- Wordmark mare, taiat de marginea de jos -->
    <p
      class="font-display -mb-3 select-none overflow-hidden text-[19vw] font-black uppercase leading-[0.75] tracking-tighter text-bone/[0.07]"
      aria-hidden="true"
    >
      {site.name}
    </p>

    <div
      class="flex flex-col gap-6 border-t border-moss/30 pt-8 md:flex-row md:items-center md:justify-between"
    >
      <div class="label leading-relaxed">
        <p>© {year} {site.name}. {t.footer.rights}</p>
        <p>{t.footer.photos(photoCredit)}</p>
      </div>

      <div class="flex flex-col gap-5 md:items-end">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {
            quick.map((l) => (
              <li>
                <a
                  class="label transition-colors hover:text-slime"
                  href={l.href}
                  {...(l.ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
        <LangSwitch lang={lang} route={route} />
      </div>
    </div>
  </div>
</footer>
