---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const gameSchema = {
  '@type': 'VideoGame',
  '@id': `${site.url}/joc#game`,
  name: 'Giardia — The Game',
  url: `${site.url}/joc`,
  description:
    'Joc arcade în browser: ești un parazit Giardia într-un intestin. Mănâncă, crește și ferește-te de pastilele de metronidazol.',
  genre: ['Arcade', 'Snake'],
  gamePlatform: 'Web browser',
  applicationCategory: 'Game',
  operatingSystem: 'Any',
  inLanguage: 'ro-RO',
  author: { '@id': `${site.url}/#band` },
  publisher: { '@id': `${site.url}/#band` },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'RON' },
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Acasă', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Joc', item: `${site.url}/joc` },
  ],
};

const controls = [
  { keys: '↑ ↓ ← →', what: 'Mișcare' },
  { keys: 'W A S D', what: 'Alternativ' },
  { keys: 'Swipe', what: 'Pe telefon' },
  { keys: 'Space', what: 'Pauză' },
];
---

<Base
  title="Joc"
  description="Giardia — The Game: joc arcade gratuit în browser. Ești parazitul, intestinul e terenul. Mănâncă tot și ferește-te de metronidazol."
  path="/joc"
  schema={[gameSchema, breadcrumb]}
>
  <Nav />

  <main id="continut" class="mx-auto max-w-[100rem] px-5 pb-24 pt-28 md:px-8 md:pt-32">
    <nav aria-label="Firimituri" class="label mb-6">
      <a href="/" class="transition-colors hover:text-slime">Acasă</a>
      <span class="mx-2 text-moss">/</span>
      <span class="text-bone">Joc</span>
    </nav>

    <header class="mb-10">
      <h1 class="display-fill text-bone">
        Giardia<br /><span class="text-slime">The Game</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-bone/80">
        Ești un trofozoit. Intestinul e al tău până când nu mai e. Mănâncă
        nutrienții, prinde bila violet pentru bonus și evită pastilele.
      </p>
    </header>

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <!-- Arena -->
      <div class="relative mx-auto w-full max-w-[42rem]">
        <div class="relative aspect-square border border-moss/50 bg-void">
          <canvas
            id="arena"
            class="h-full w-full touch-none"
            aria-label="Arena jocului Giardia"
            role="img"></canvas>

          <div
            id="overlay"
            class="absolute inset-0 z-10 flex flex-col items-center justify-center gap-4 bg-void/85 p-8 text-center backdrop-blur-sm"
          >
            <h2
              id="overlay-title"
              class="font-display text-5xl font-black uppercase text-bone md:text-7xl"
            >
              Giardia
            </h2>
            <p id="overlay-text" class="max-w-xs text-bone/75"></p>
            <button id="overlay-btn" class="btn btn-solid mt-2" type="button">
              Start
            </button>
          </div>
        </div>

        <!-- Scor -->
        <div class="mt-4 flex items-center justify-between gap-4 border-t border-moss/40 pt-4">
          <div class="flex gap-8">
            <div>
              <p class="label">Scor</p>
              <p id="score" class="font-display text-4xl font-black leading-none text-slime">
                0
              </p>
            </div>
            <div>
              <p class="label">Record</p>
              <p id="high" class="font-display text-4xl font-black leading-none text-bone/60">
                0
              </p>
            </div>
          </div>
          <button
            id="mute"
            type="button"
            class="label border border-moss/50 px-3 py-2 transition-colors hover:border-slime hover:text-slime"
            aria-pressed="false"
          >
            Sunet: on
          </button>
        </div>
      </div>

      <!-- Instructiuni -->
      <aside class="lg:pt-0">
        <h2 class="font-display mb-4 text-3xl font-bold uppercase text-bone">Controale</h2>
        <ul class="border-t border-moss/40">
          {
            controls.map((c) => (
              <li class="flex items-center justify-between gap-4 border-b border-moss/20 py-3">
                <span class="font-mono text-sm text-slime">{c.keys}</span>
                <span class="label">{c.what}</span>
              </li>
            ))
          }
        </ul>

        <h2 class="font-display mb-4 mt-10 text-3xl font-bold uppercase text-bone">
          Reguli
        </h2>
        <ul class="flex flex-col gap-3 text-sm text-bone/75">
          <li class="flex gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-slime"></span>
            <span>Nutrient verde: +10 puncte, crești cu un segment.</span>
          </li>
          <li class="flex gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-viral"></span>
            <span>Bilă violet: +50 puncte și încetinește timpul 4 secunde.</span>
          </li>
          <li class="flex gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-bone"></span>
            <span>Pastilă de metronidazol: te omoară. Dispare singură.</span>
          </li>
          <li class="flex gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-moss"></span>
            <span>Peretele intestinal și propriul corp sunt fatale.</span>
          </li>
        </ul>

        <p class="mt-10 border-l-2 border-moss/50 pl-4 text-sm text-bone/60">
          Recordul se salvează în browserul tău. Ștergi datele site-ului, îl
          pierzi.
        </p>
      </aside>
    </div>
  </main>

  <Footer />
</Base>

<script>
  import { startGiardia } from '../game/giardia';

  const canvas = document.getElementById('arena') as HTMLCanvasElement | null;
  if (canvas) {
    startGiardia(canvas, {
      score: document.getElementById('score')!,
      high: document.getElementById('high')!,
      overlay: document.getElementById('overlay')!,
      overlayTitle: document.getElementById('overlay-title')!,
      overlayText: document.getElementById('overlay-text')!,
      overlayBtn: document.getElementById('overlay-btn')!,
      muteBtn: document.getElementById('mute') as HTMLButtonElement,
    });
  }
</script>
