---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Music from '../components/Music.astro';
import Gallery from '../components/Gallery.astro';
import Shows from '../components/Shows.astro';
import Merch from '../components/Merch.astro';
import GameTeaser from '../components/GameTeaser.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { site, releases, shows } from '../data/site';

const album = releases.find((r) => r.type === 'album')!;

/* Albumul, ca entitate proprie — asa poate aparea in rezultate bogate. */
const albumSchema = {
  '@type': 'MusicAlbum',
  '@id': `${site.url}/#album-vol1`,
  name: album.title,
  albumProductionType: 'https://schema.org/StudioAlbum',
  albumReleaseType: 'https://schema.org/AlbumRelease',
  datePublished: String(album.year),
  byArtist: { '@id': `${site.url}/#band` },
  genre: site.genres,
  numTracks: album.tracks.length,
  track: album.tracks.map((name, i) => ({
    '@type': 'MusicRecording',
    position: i + 1,
    name,
    byArtist: { '@id': `${site.url}/#band` },
  })),
};

/* Concertele viitoare, daca exista. */
const eventSchema = shows.map((s) => ({
  '@type': 'MusicEvent',
  name: `GIARDIA live — ${s.city}`,
  startDate: s.date,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: s.venue, address: s.city },
  performer: { '@id': `${site.url}/#band` },
  ...(s.ticketUrl ? { offers: { '@type': 'Offer', url: s.ticketUrl } } : {}),
}));

const marqueeItems = [...album.tracks, 'Vol. 1 afară acum'];
---

<Base path="/" schema={[albumSchema, ...eventSchema]}>
  <Nav />
  <main id="continut">
    <Hero />
    <Marquee items={marqueeItems} solid />
    <Music />
    <Gallery />
    <Marquee items={['Groove', 'Thrash', 'Riff', 'Live', 'România']} />
    <Shows />
    <Merch />
    <GameTeaser />
    <Contact />
  </main>
  <Footer />
</Base>
